APP_NAME=KrushiPragya
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=
DIRECT_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
